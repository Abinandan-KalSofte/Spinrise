            }
          }
        },
        {
          "name": "Approve",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prNo\": 12345,\n  \"prDate\": \"2026-06-01\",\n  \"lines\": [\n    { \"prSno\": 1, \"approved\": true }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pr-first-approval/approve?divCode={{divCode}}",
              "host": ["{{baseUrl}}"], "path": ["api","v1","pr-first-approval","approve"],
              "query": [{ "key": "divCode", "value": "{{divCode}}" }]
            }
          }
        },
        {
          "name": "Delete Approval",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prNo\": 12345,\n  \"prDate\": \"2026-06-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pr-first-approval/delete-approval?divCode={{divCode}}",
              "host": ["{{baseUrl}}"], "path": ["api","v1","pr-first-approval","delete-approval"],
              "query": [{ "key": "divCode", "value": "{{divCode}}" }]
            }
          }
        },
        {
          "name": "Print Approval Report (PDF)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/pr-first-approval/12345/print?divCode={{divCode}}&prDate=2026-06-01",
              "host": ["{{baseUrl}}"], "path": ["api","v1","pr-first-approval","12345","print"],
              "query": [
                { "key": "divCode", "value": "{{divCode}}" },
                { "key": "prDate",  "value": "2026-06-01" }
              ]
            }
          }
        }
      ]
    },

    {
      "name": "04 — PR Final Level Approval",
      "item": [
        {
          "name": "Get Pending PRs",
          "request": {
            "method": "GET",
            "url": {
