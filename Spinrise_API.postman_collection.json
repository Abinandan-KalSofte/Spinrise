              "raw": "{{baseUrl}}/api/v1/pr-first-approval/approved?divCode={{divCode}}&yfDate={{fDate}}&ylDate={{lDate}}",
              "host": ["{{baseUrl}}"], "path": ["api","v1","pr-first-approval","approved"],
              "query": [
                { "key": "divCode", "value": "{{divCode}}" },
                { "key": "yfDate",  "value": "{{fDate}}" },
                { "key": "ylDate",  "value": "{{lDate}}" }
              ]
