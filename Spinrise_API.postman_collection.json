            "url": {
              "raw": "{{baseUrl}}/api/v1/finallevel-pr/items/ITEM001/purchase-history?divCode={{divCode}}",
              "host": ["{{baseUrl}}"], "path": ["api","v1","finallevel-pr","items","ITEM001","purchase-history"],
