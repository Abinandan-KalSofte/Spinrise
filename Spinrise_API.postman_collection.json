{
  "info": {
    "name": "Spinrise ERP V2",
    "description": "All API endpoints for Spinrise ERP V2. Set {{token}} by running the Login request first.\nBase URL: http://localhost:5000 (dev) | http://172.16.16.40:5001 (server)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl",  "value": "http://localhost:5000",  "type": "string" },
    { "key": "token",    "value": "",                        "type": "string" },
    { "key": "divCode",  "value": "01",                     "type": "string" },
    { "key": "dbName",   "value": "JAT",                    "type": "string" },
    { "key": "fDate",    "value": "2026-04-01",             "type": "string" },
    { "key": "lDate",    "value": "2026-06-30",             "type": "string" }
  ],
  "item": [

    {
      "name": "01 — Security",
      "item": [

        {
          "name": "Auth",
          "item": [
            {
              "name": "Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var json = pm.response.json();",
                      "if (json.data && json.data.accessToken) {",
                      "    pm.collectionVariables.set('token', json.data.accessToken);",
                      "    pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-DB-Name",    "value": "{{dbName}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"KSL\",\n  \"password\": \"your_password\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] }
              }
            },
            {
              "name": "Refresh Token",
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","refresh"] }
              }
            },
            {
              "name": "Logout",
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                },
                "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","logout"] }
              }
            }
          ]
        },

        {
          "name": "Databases",
          "item": [
            {
              "name": "Get Databases",
              "request": {
                "auth": { "type": "noauth" },
                "method": "GET",
                "url": { "raw": "{{baseUrl}}/api/v1/databases", "host": ["{{baseUrl}}"], "path": ["api","v1","databases"] }
              }
            }
          ]
        },

        {
          "name": "Companies",
          "item": [
            {
              "name": "Get Active Companies",
              "request": {
                "auth": { "type": "noauth" },
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/companies/active?db={{dbName}}",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","companies","active"],
                  "query": [{ "key": "db", "value": "{{dbName}}" }]
                }
              }
            }
          ]
        },

        {
          "name": "Divisions",
          "item": [
            {
              "name": "Get Active Divisions",
              "request": {
                "auth": { "type": "noauth" },
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/divisions/active?db={{dbName}}",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","divisions","active"],
                  "query": [{ "key": "db", "value": "{{dbName}}" }]
                }
              }
            }
          ]
        }

      ]
    },

    {
      "name": "02 — Purchase Requisition",
      "item": [

        {
          "name": "Screen Init",
          "item": [
            {
              "name": "Get Permissions",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr/permissions?divCode={{divCode}}",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr","permissions"],
                  "query": [{ "key": "divCode", "value": "{{divCode}}" }]
                }
              }
            },
            {
              "name": "Get Parameters",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr/parameters?divCode={{divCode}}",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr","parameters"],
                  "query": [{ "key": "divCode", "value": "{{divCode}}" }]
                }
              }
            },
            {
              "name": "Pre-Add Checks",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr/pre-add-checks?divCode={{divCode}}",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr","pre-add-checks"],
                  "query": [{ "key": "divCode", "value": "{{divCode}}" }]
                }
              }
            }
          ]
        },

        {
          "name": "Lookups",
          "item": [
            {
              "name": "Get Departments",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr/departments?divCode={{divCode}}&search=",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr","departments"],
                  "query": [{ "key": "divCode", "value": "{{divCode}}" }, { "key": "search", "value": "" }]
                }
              }
            },
            {
              "name": "Get Employees",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr/employees?divCode={{divCode}}&empCommon=N&search=",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr","employees"],
                  "query": [
                    { "key": "divCode",   "value": "{{divCode}}" },
                    { "key": "empCommon", "value": "N" },
                    { "key": "search",    "value": "" }
                  ]
                }
              }
            },
            {
              "name": "Get PR Types",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr/pr-types?activeOnly=true",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr","pr-types"],
                  "query": [{ "key": "activeOnly", "value": "true" }]
                }
              }
            },
            {
              "name": "Get Items",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr/items?divCode={{divCode}}&search=&itemGrpCode=&page=1&pageSize=50",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr","items"],
                  "query": [
                    { "key": "divCode",     "value": "{{divCode}}" },
                    { "key": "search",      "value": "" },
                    { "key": "itemGrpCode", "value": "" },
                    { "key": "page",        "value": "1" },
                    { "key": "pageSize",    "value": "50" }
                  ]
                }
              }
            },
            {
              "name": "Get Item Detail",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr/items/ITEM001/detail?divCode={{divCode}}&fDate={{fDate}}&lDate={{lDate}}&pDate={{fDate}}",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr","items","ITEM001","detail"],
                  "query": [
                    { "key": "divCode", "value": "{{divCode}}" },
                    { "key": "fDate",   "value": "{{fDate}}" },
                    { "key": "lDate",   "value": "{{lDate}}" },
                    { "key": "pDate",   "value": "{{fDate}}" }
                  ]
                }
              }
            },
            {
              "name": "Get Machine Lookup",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr/machine-lookup?divCode={{divCode}}&depCode=01&search=",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr","machine-lookup"],
                  "query": [
                    { "key": "divCode", "value": "{{divCode}}" },
                    { "key": "depCode", "value": "01" },
                    { "key": "search",  "value": "" }
                  ]
                }
              }
            },
            {
              "name": "Get Cost Centre Lookup",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr/cost-centre-lookup?divCode={{divCode}}&search=",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr","cost-centre-lookup"],
                  "query": [
                    { "key": "divCode", "value": "{{divCode}}" },
                    { "key": "search",  "value": "" }
                  ]
                }
              }
            },
            {
              "name": "Check Pending Order",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr/items/ITEM001/pending-order?divCode={{divCode}}&fDate={{fDate}}&lDate={{lDate}}&depCode=01",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr","items","ITEM001","pending-order"],
                  "query": [
                    { "key": "divCode", "value": "{{divCode}}" },
                    { "key": "fDate",   "value": "{{fDate}}" },
                    { "key": "lDate",   "value": "{{lDate}}" },
                    { "key": "depCode", "value": "01" }
                  ]
                }
              }
            }
          ]
        },

        {
          "name": "PR Data",
          "item": [
            {
              "name": "Get Last Record",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr/last?divCode={{divCode}}&fDate={{fDate}}&lDate={{lDate}}",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr","last"],
                  "query": [
                    { "key": "divCode", "value": "{{divCode}}" },
                    { "key": "fDate",   "value": "{{fDate}}" },
                    { "key": "lDate",   "value": "{{lDate}}" }
                  ]
                }
              }
            },
            {
              "name": "Get By ID",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr/12345?divCode={{divCode}}&prDate=2026-06-01",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr","12345"],
                  "query": [
                    { "key": "divCode", "value": "{{divCode}}" },
                    { "key": "prDate",  "value": "2026-06-01" }
                  ]
                }
              }
            },
            {
              "name": "Get List",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr?divCode={{divCode}}&fDate={{fDate}}&lDate={{lDate}}&mode=FIND&page=1&pageSize=50",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr"],
                  "query": [
                    { "key": "divCode",  "value": "{{divCode}}" },
                    { "key": "fDate",    "value": "{{fDate}}" },
                    { "key": "lDate",    "value": "{{lDate}}" },
                    { "key": "mode",     "value": "FIND" },
                    { "key": "depCode",  "value": "", "disabled": true },
                    { "key": "reqName",  "value": "", "disabled": true },
                    { "key": "poGrp",    "value": "", "disabled": true },
                    { "key": "search",   "value": "", "disabled": true },
                    { "key": "page",     "value": "1" },
                    { "key": "pageSize", "value": "50" }
                  ]
                }
              }
            }
          ]
        },

        {
          "name": "CRUD",
          "item": [
            {
              "name": "Add PR",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"prDate\": \"2026-06-13\",\n  \"prType\": \"GN\",\n  \"depCode\": \"01\",\n  \"reqName\": \"1\",\n  \"remarks\": \"\",\n  \"lines\": [\n    {\n      \"itemCode\": \"ITEM001\",\n      \"qty\": 10,\n      \"rate\": 0,\n      \"remarks\": \"\",\n      \"macNo\": \"\",\n      \"ccCode\": \"\"\n    }\n  ]\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr?divCode={{divCode}}&fDate={{fDate}}&lDate={{lDate}}",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr"],
                  "query": [
                    { "key": "divCode", "value": "{{divCode}}" },
                    { "key": "fDate",   "value": "{{fDate}}" },
                    { "key": "lDate",   "value": "{{lDate}}" }
                  ]
                }
              }
            },
            {
              "name": "Modify PR",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"prNo\": 12345,\n  \"prDate\": \"2026-06-13\",\n  \"prType\": \"GN\",\n  \"depCode\": \"01\",\n  \"reqName\": \"1\",\n  \"remarks\": \"Updated\",\n  \"lines\": [\n    {\n      \"prSno\": 1,\n      \"itemCode\": \"ITEM001\",\n      \"qty\": 15,\n      \"rate\": 0,\n      \"remarks\": \"\",\n      \"macNo\": \"\",\n      \"ccCode\": \"\"\n    }\n  ]\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr?divCode={{divCode}}&fDate={{fDate}}&lDate={{lDate}}",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr"],
                  "query": [
                    { "key": "divCode", "value": "{{divCode}}" },
                    { "key": "fDate",   "value": "{{fDate}}" },
                    { "key": "lDate",   "value": "{{lDate}}" }
                  ]
                }
              }
            },
            {
              "name": "Delete PR",
              "request": {
                "method": "DELETE",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"prNo\": 12345,\n  \"prDate\": \"2026-06-13\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr?divCode={{divCode}}",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr"],
                  "query": [{ "key": "divCode", "value": "{{divCode}}" }]
                }
              }
            }
          ]
        },

        {
          "name": "Print & Image",
          "item": [
            {
              "name": "Print PR (PDF)",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr/12345/print?divCode={{divCode}}&prDate=2026-06-01",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr","12345","print"],
                  "query": [
                    { "key": "divCode", "value": "{{divCode}}" },
                    { "key": "prDate",  "value": "2026-06-01" }
                  ]
                }
              }
            },
            {
              "name": "Get Item Image",
              "request": {
                "auth": { "type": "noauth" },
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pr/items/ITEM001/image",
                  "host": ["{{baseUrl}}"], "path": ["api","v1","pr","items","ITEM001","image"]
                }
              }
            }
          ]
        }

      ]
    },

    {
      "name": "03 — PR First Level Approval",
      "item": [
        {
          "name": "Get PO Para",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/pr-first-approval/po-para?divCode={{divCode}}",
              "host": ["{{baseUrl}}"], "path": ["api","v1","pr-first-approval","po-para"],
              "query": [{ "key": "divCode", "value": "{{divCode}}" }]
            }
          }
        },
        {
          "name": "Get Departments (for user)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/pr-first-approval/departments?divCode={{divCode}}",
              "host": ["{{baseUrl}}"], "path": ["api","v1","pr-first-approval","departments"],
              "query": [{ "key": "divCode", "value": "{{divCode}}" }]
