          }
        },
        {
          "name": "Get PR Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/pr-first-approval/detail?divCode={{divCode}}&prNo=12345&prDate=2026-06-01",
              "host": ["{{baseUrl}}"], "path": ["api","v1","pr-first-approval","detail"],
              "query": [
                { "key": "divCode", "value": "{{divCode}}" },
                { "key": "prNo",    "value": "12345" },
                { "key": "prDate",  "value": "2026-06-01" }
