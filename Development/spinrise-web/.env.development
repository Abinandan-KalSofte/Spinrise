VITE_API_URL=http://172.16.16.40:5001/api/v1

# Runtime API mocks for demo/UAT while the backend is not ready.
# MSW intercepts by URL pathname, so the PO + auth endpoints are mocked
# regardless of VITE_API_URL; all other requests bypass to the real backend.
# TODO: set to false (or remove) once the backend APIs are available.
VITE_ENABLE_MOCKS=true
